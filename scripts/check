#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

destination="platform=macOS,arch=$(uname -m)"
swift test --package-path Packages/ResonanceKit
xcodebuild -project Resonance.xcodeproj -scheme Resonance \
    -destination "$destination" -derivedDataPath DerivedData build
xcodebuild -project Resonance.xcodeproj -scheme Resonance \
    -testPlan Deterministic -destination "$destination" -derivedDataPath DerivedData test
